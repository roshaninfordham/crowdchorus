# Copy to .env.local. Everything is optional for a local demo: each unset
# integration falls back to a clearly labelled local path (see docs/ARCHITECTURE.md).
DATABASE_URL=postgres://postgres:crowdchorus@localhost:5434/crowdchorus
STORAGE_DIR=./storage
MEDIA_SIGNING_SECRET=change-me-to-32-random-bytes
PUBLIC_BASE_URL=

# Provider per capability: auto (vendor when its key is set, else local), local, or a vendor name.
TEXT_PROVIDER=auto
IMAGE_PROVIDER=auto
MUSIC_PROVIDER=auto
SEARCH_PROVIDER=auto
ANALYTICS_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
LYRIA_MODEL=lyria-3-clip-preview

NIMBLE_API_KEY=

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=CROWDCHORUS
SNOWFLAKE_SCHEMA=PUBLIC

SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

RETENTION_HOURS=24
